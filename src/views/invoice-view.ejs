<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice — InvoiceTool</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:'Inter',sans-serif; background:#0b0d15; color:#e8edf5; min-height:100vh; }
        .container { max-width:1120px; margin:0 auto; padding:0 24px; }
        header { padding:20px 0; border-bottom:1px solid rgba(255,255,255,0.06); background:rgba(11,13,21,0.85); backdrop-filter:blur(8px); }
        .nav { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; }
        .nav-left { display:flex; align-items:center; gap:12px; }
        .back-btn { color:#b0b8c8; text-decoration:none; font-size:20px; cursor:pointer; transition:0.2s; line-height:1; }
        .back-btn:hover { color:#fff; transform:scale(1.1); }
        .brand { font-size:24px; font-weight:800; color:#fff; text-decoration:none; }
        .brand span { background:linear-gradient(135deg,#6c5ce7,#a29bfe); padding:2px 10px; border-radius:6px; }
        .nav-links { display:flex; gap:20px; align-items:center; flex-wrap:wrap; }
        .nav-links a { color:#b0b8c8; text-decoration:none; font-size:15px; font-weight:500; }
        .nav-links a:hover { color:#fff; }
        .btn-primary { background:linear-gradient(135deg,#6c5ce7,#a29bfe); color:#fff; border:none; padding:10px 28px; border-radius:40px; font-weight:600; cursor:pointer; transition:0.2s; text-decoration:none; display:inline-block; }
        .btn-primary:hover { transform:translateY(-2px); box-shadow:0 8px 30px rgba(108,92,231,0.35); }
        .btn-secondary { background:transparent; color:#b0b8c8; border:1px solid rgba(255,255,255,0.12); padding:10px 28px; border-radius:40px; font-weight:500; cursor:pointer; transition:0.2s; text-decoration:none; display:inline-block; }
        .btn-secondary:hover { background:rgba(255,255,255,0.06); color:#fff; }
        .btn-danger { background:transparent; color:#f87171; border:1px solid #f87171; padding:10px 28px; border-radius:40px; font-weight:500; cursor:pointer; transition:0.2s; text-decoration:none; display:inline-block; }
        .btn-danger:hover { background:#f87171; color:#fff; }
        .card { background:#141824; border-radius:16px; padding:24px; border:1px solid rgba(255,255,255,0.06); margin-bottom:24px; }
        .card h3 { color:#fff; font-size:18px; margin-bottom:16px; }
        .invoice-preview { background:#141824; border-radius:16px; padding:32px; border:1px solid rgba(255,255,255,0.06); }
        .invoice-preview .header { display:flex; justify-content:space-between; margin-bottom:30px; flex-wrap:wrap; gap:16px; }
        .invoice-preview .header .title { font-size:28px; font-weight:800; color:#fff; }
        .invoice-preview .header .meta { color:#8892a8; font-size:14px; text-align:right; }
        .invoice-preview .from-to { display:grid; grid-template-columns:1fr 1fr; gap:30px; margin-bottom:30px; }
        .invoice-preview .from-to .block h4 { color:#8892a8; font-size:13px; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px; }
        .invoice-preview .from-to .block p { color:#e8edf5; font-size:14px; line-height:1.6; }
        .invoice-preview table { width:100%; border-collapse:collapse; margin:20px 0; }
        .invoice-preview table th { text-align:left; color:#8892a8; font-size:13px; font-weight:600; padding:8px 12px; border-bottom:1px solid rgba(255,255,255,0.06); }
        .invoice-preview table td { padding:8px 12px; border-bottom:1px solid rgba(255,255,255,0.04); color:#e8edf5; font-size:14px; }
        .invoice-preview .totals { text-align:right; margin-top:20px; }
        .invoice-preview .totals .row { display:flex; justify-content:flex-end; gap:40px; padding:4px 0; }
        .invoice-preview .totals .row .label { color:#8892a8; }
        .invoice-preview .totals .row .value { color:#e8edf5; font-weight:600; }
        .invoice-preview .totals .grand { font-size:20px; font-weight:800; color:#fff; border-top:1px solid rgba(255,255,255,0.06); padding-top:12px; margin-top:8px; }
        .invoice-preview .totals .grand .value { color:#6c5ce7; }
        .actions { display:flex; gap:12px; margin-top:24px; flex-wrap:wrap; }
        .loading { text-align:center; padding:40px 0; color:#8892a8; font-size:18px; }
        .error-box { background:#2a1418; color:#f87171; padding:16px; border-radius:12px; text-align:center; }
        .site-footer { margin-top:60px; padding:30px 0; border-top:1px solid rgba(255,255,255,0.06); text-align:center; }
        .disclaimer { font-size:13px; color:#6b7488; max-width:700px; margin:0 auto 12px; line-height:1.7; }
        .copyright { font-size:13px; color:#4a5266; }
        @media (max-width:768px) { .nav-links { gap:12px; } .invoice-preview .from-to { grid-template-columns:1fr; } .invoice-preview .header { flex-direction:column; } .invoice-preview .header .meta { text-align:left; } }
    </style>
</head>
<body>
    <header>
        <div class="container nav">
            <div class="nav-left">
                <a href="/dashboard" class="back-btn">←</a>
                <a class="brand" href="/dashboard">Invoice<span>Tool</span></a>
            </div>
            <nav class="nav-links">
                <a href="/dashboard">Dashboard</a>
                <a href="/invoices/new">New Invoice</a>
                <a href="/billing">Billing</a>
                <button id="logoutBtn" style="background:none;border:none;color:#b0b8c8;cursor:pointer;font-size:15px;font-weight:500;">Log out</button>
            </nav>
        </div>
    </header>

    <main class="container">
        <div id="app">
            <div class="loading">Loading invoice...</div>
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <p class="disclaimer"><strong>Disclaimer:</strong> This tool generates invoice templates for informational purposes only. Not legal or tax advice. Please consult a qualified professional. We are not responsible for any errors or financial losses. By using this tool, you agree you are solely responsible for your invoices.</p>
            <p class="copyright">&copy; 2026 InvoiceTool</p>
        </div>
    </footer>

    <script>
        const token = localStorage.getItem('accessToken');
        if (!token) {
            window.location.href = '/login';
        }

        document.getElementById('logoutBtn').addEventListener('click', function() {
            localStorage.removeItem('accessToken');
            localStorage.removeItem('refreshToken');
            localStorage.removeItem('userEmail');
            window.location.href = '/login';
        });

        const pathParts = window.location.pathname.split('/');
        const invoiceId = pathParts[pathParts.length - 1];

        async function loadInvoice() {
            try {
                const res = await fetch(`/invoices/data/${invoiceId}`, {
                    headers: {
                        'Authorization': 'Bearer ' + token
                    }
                });
                if (res.status === 401 || res.status === 302) {
                    localStorage.removeItem('accessToken');
                    window.location.href = '/login';
                    return;
                }
                if (!res.ok) {
                    document.getElementById('app').innerHTML = '<div class="error-box">Invoice not found.</div>';
                    return;
                }
                const data = await res.json();
                renderInvoice(data.invoice);
            } catch (e) {
                document.getElementById('app').innerHTML = '<div class="error-box">Error loading invoice.</div>';
            }
        }

        function renderInvoice(invoice) {
            if (!invoice) {
                document.getElementById('app').innerHTML = '<div class="error-box">Invoice not found.</div>';
                return;
            }

            const from = invoice.from_json || {};
            const to = invoice.to_json || {};
            const items = invoice.items || [];
            const total = items.reduce((sum, item) => sum + (parseFloat(item.rate) || 0) * (parseFloat(item.qty) || 0), 0);
            const totalDisplay = total.toFixed(2);

            const issueDate = invoice.issue_date || 'N/A';
            const dueDate = invoice.due_date || 'N/A';

            let html = `
                <h1 style="font-size:28px;font-weight:800;margin:24px 0 8px;">Invoice ${invoice.invoice_number}</h1>
                <div class="actions">
                    <button class="btn-primary" onclick="window.print()">Print</button>
                    <button class="btn-secondary" onclick="alert('Please use Print > Save as PDF to download.');">Download PDF</button>
                    <button class="btn-danger" id="deleteBtn">Delete</button>
                    <a href="/dashboard" class="btn-secondary">Back</a>
                </div>

                <div class="invoice-preview" style="margin-top:24px;">
                    <div class="header">
                        <div>
                            <div class="title">INVOICE</div>
                        </div>
                        <div class="meta">
                            <div><strong>${invoice.invoice_number}</strong></div>
                            <div>Issued: ${issueDate}</div>
                            <div>Due: ${dueDate}</div>
                            <div>Status: <span style="color:#6c5ce7;font-weight:600;">${invoice.status || 'draft'}</span></div>
                        </div>
                    </div>

                    <div class="from-to">
                        <div class="block">
                            <h4>From</h4>
                            <p><strong>${from.name || 'N/A'}</strong></p>
                            <p>${from.email || ''}</p>
                            <p>${from.phone || ''}</p>
                            <p>${from.address || ''} ${from.city || ''} ${from.country || ''}</p>
                            ${from.tax_id ? `<p>Tax ID: ${from.tax_id}</p>` : ''}
                        </div>
                        <div class="block">
                            <h4>Bill To</h4>
                            <p><strong>${to.name || 'N/A'}</strong></p>
                            <p>${to.company || ''}</p>
                            <p>${to.email || ''}</p>
                            <p>${to.city || ''} ${to.country || ''}</p>
                        </div>
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th style="text-align:center;">Qty</th>
                                <th style="text-align:right;">Rate</th>
                                <th style="text-align:right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${items.map(item => `
                                <tr>
                                    <td>${item.description || ''}</td>
                                    <td style="text-align:center;">${item.qty || 0}</td>
                                    <td style="text-align:right;">$${parseFloat(item.rate || 0).toFixed(2)}</td>
                                    <td style="text-align:right;">$${(parseFloat(item.qty || 0) * parseFloat(item.rate || 0)).toFixed(2)}</td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>

                    <div class="totals">
                        <div class="row"><span class="label">Subtotal</span><span class="value">$${totalDisplay}</span></div>
                        ${invoice.discount && invoice.discount > 0 ? `<div class="row"><span class="label">Discount (${invoice.discount_type || 'flat'})</span><span class="value">-$${parseFloat(invoice.discount).toFixed(2)}</span></div>` : ''}
                        ${invoice.tax_rate && invoice.tax_rate > 0 ? `<div class="row"><span class="label">Tax (${invoice.tax_rate}%)</span><span class="value">$${(total * parseFloat(invoice.tax_rate) / 100).toFixed(2)}</span></div>` : ''}
                        <div class="row grand"><span class="label">Total</span><span class="value">$${invoice.total || totalDisplay}</span></div>
                    </div>

                    ${invoice.notes ? `<div style="margin-top:20px;color:#8892a8;font-size:14px;"><strong>Notes:</strong> ${invoice.notes}</div>` : ''}
                </div>
            `;

            document.getElementById('app').innerHTML = html;

            // 删除按钮：移入回收站
            document.getElementById('deleteBtn').addEventListener('click', async function() {
                if (!confirm('将这张发票移入回收站？')) return;

                try {
                    const res = await fetch(`/invoices/${invoiceId}`, {
                        method: 'DELETE',
                        headers: {
                            'Authorization': 'Bearer ' + token,
                            'Content-Type': 'application/json'
                        }
                    });
                    const data = await res.json();
                    if (data.success) {
                        window.location.href = '/dashboard';
                    } else {
                        alert('操作失败，请重试。');
                    }
                } catch (e) {
                    alert('网络错误，请重试。');
                }
            });
        }

        loadInvoice();
    </script>
</body>
</html>