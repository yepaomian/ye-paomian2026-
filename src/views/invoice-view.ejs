<div class="page-head">
  <h1>Invoice <%= invoice.invoice_number %></h1>
  <div class="invoice-actions">
    <a href="/invoices/<%= invoice.id %>/pdf" class="btn btn-primary">Download PDF</a>
    <button type="button" class="btn btn-ghost" onclick="window.print()">Print</button>
    <a href="/invoices/<%= invoice.id %>/edit" class="btn btn-ghost">Edit</a>
    <a href="/dashboard" class="btn btn-ghost">Back</a>
  </div>
</div>

<div class="invoice-preview">
  <%- include('templates/template' + invoice.template + '.ejs') %>
</div>
