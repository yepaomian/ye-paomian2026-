<div class="auth-card">
  <h1>Log in</h1>
  <form method="post" action="/login" class="auth-form">
    <label>Email
      <input type="email" name="email" value="<%= values.email || '' %>" required autofocus />
    </label>
    <label>Password
      <input type="password" name="password" required />
    </label>
    <button type="submit" class="btn btn-primary btn-block">Log in</button>
  </form>
  <p class="auth-alt">No account? <a href="/register">Sign up free</a></p>
</div>
