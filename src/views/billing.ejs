<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Billing — InvoiceTool</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:'Inter',sans-serif; background:#0b0d15; color:#e8edf5; min-height:100vh; }
        .container { max-width:1120px; margin:0 auto; padding:0 24px; }
        header { padding:20px 0; border-bottom:1px solid rgba(255,255,255,0.06); background:rgba(11,13,21,0.85); backdrop-filter:blur(8px); }
        .nav { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; }
        .brand { font-size:24px; font-weight:800; color:#fff; text-decoration:none; }
        .brand span { background:linear-gradient(135deg,#6c5ce7,#a29bfe); padding:2px 10px; border-radius:6px; }
        .nav-links { display:flex; gap:20px; align-items:center; flex-wrap:wrap; }
        .nav-links a { color:#b0b8c8; text-decoration:none; font-size:15px; font-weight:500; }
        .nav-links a:hover { color:#fff; }
        .btn-primary { background:linear-gradient(135deg,#6c5ce7,#a29bfe); color:#fff; border:none; padding:10px 28px; border-radius:40px; font-weight:600; cursor:pointer; transition:0.2s; text-decoration:none; display:inline-block; }
        .btn-primary:hover { transform:translateY(-2px); box-shadow:0 8px 30px rgba(108,92,231,0.35); }
        .btn-outline { background:transparent; color:#b0b8c8; border:1px solid rgba(255,255,255,0.12); padding:10px 28px; border-radius:40px; font-weight:500; cursor:pointer; transition:0.2s; text-decoration:none; display:inline-block; }
        .btn-outline:hover { background:rgba(255,255,255,0.06); color:#fff; }
        .pricing-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:24px; margin:40px 0; }
        .pricing-card { background:#141824; border-radius:20px; padding:32px; border:1px solid rgba(255,255,255,0.06); text-align:center; transition:0.25s; }
        .pricing-card:hover { transform:translateY(-4px); border-color:rgba(108,92,231,0.4); }
        .pricing-card .name { font-size:20px; font-weight:700; color:#fff; }
        .pricing-card .price { font-size:40px; font-weight:800; color:#fff; margin:12px 0 4px; }
        .pricing-card .price span { font-size:16px; font-weight:400; color:#8892a8; }
        .pricing-card .desc { color:#8892a8; font-size:14px; margin-bottom:16px; }
        .pricing-card ul { list-style:none; padding:0; margin:16px 0; text-align:left; }
        .pricing-card ul li { padding:6px 0; color:#b0b8c8; font-size:14px; display:flex; align-items:center; gap:10px; }
        .pricing-card ul li::before { content:"✓"; color:#6c5ce7; font-weight:700; }
        .pricing-card .badge { display:inline-block; background:#6c5ce7; color:#fff; font-size:12px; font-weight:600; padding:4px 14px; border-radius:20px; margin-bottom:12px; }
        .site-footer { margin-top:60px; padding:30px 0; border-top:1px solid rgba(255,255,255,0.06); text-align:center; }
        .disclaimer { font-size:13px; color:#6b7488; max-width:700px; margin:0 auto 12px; line-height:1.7; }
        .copyright { font-size:13px; color:#4a5266; }
        .flash { padding:12px 20px; border-radius:12px; margin:16px 0; background:#1a1a2e; border:1px solid rgba(255,255,255,0.06); color:#b0b8c8; }
        @media (max-width:768px) { .nav-links { gap:12px; } .pricing-grid { grid-template-columns:1fr; } }
    </style>
</head>
<body>
    <header>
        <div class="container nav">
            <a class="brand" href="/dashboard">Invoice<span>Tool</span></a>
            <nav class="nav-links">
                <a href="/dashboard">Dashboard</a>
                <a href="/invoices/new">New Invoice</a>
                <a href="/billing">Billing</a>
                <form method="post" action="/logout" style="display:inline;">
                    <button type="submit" style="background:none;border:none;color:#b0b8c8;cursor:pointer;font-size:15px;font-weight:500;">Log out</button>
                </form>
            </nav>
        </div>
    </header>

    <main class="container">
        <h1 style="font-size:32px;font-weight:800;margin:24px 0 8px;">Billing & Plans</h1>
        <p style="color:#8892a8;margin-bottom:20px;">
            You are currently on the <strong style="color:#fff;"><%= quota && quota.plan ? quota.plan.name : 'Free' %></strong> plan.
        </p>

        <div class="pricing-grid">
            <div class="pricing-card" style="border-color:rgba(108,92,231,0.3);">
                <div class="badge">Current plan</div>
                <div class="name">Free</div>
                <div class="price">$0 <span>/ month</span></div>
                <ul>
                    <li>1 invoice per month</li>
                    <li>4 templates</li>
                    <li>PDF export</li>
                </ul>
                <span class="btn-outline" style="cursor:default;">Current plan</span>
            </div>
            <div class="pricing-card">
                <div class="name">Premium</div>
                <div class="price">$9.99 <span>/ month</span></div>
                <ul>
                    <li>5 invoices per month</li>
                    <li>4 templates</li>
                    <li>PDF export</li>
                    <li>Priority support</li>
                </ul>
                <a href="#" class="btn-primary">Upgrade (demo)</a>
            </div>
            <div class="pricing-card">
                <div class="name">Lifetime</div>
                <div class="price">$29.99 <span>one-time</span></div>
                <ul>
                    <li>Unlimited invoices</li>
                    <li>4 templates</li>
                    <li>PDF export</li>
                    <li>All future updates</li>
                </ul>
                <a href="#" class="btn-primary">Upgrade (demo)</a>
            </div>
        </div>
        <p style="color:#6b7488;font-size:13px;text-align:center;">Stripe not configured — upgrades run in demo mode.</p>
    </main>

    <footer class="site-footer">
        <div class="container">
            <p class="disclaimer"><strong>Disclaimer:</strong> This tool generates invoice templates for informational purposes only. Not legal or tax advice. Please consult a qualified professional. We are not responsible for any errors or financial losses. By using this tool, you agree you are solely responsible for your invoices.</p>
            <p class="copyright">&copy; 2026 InvoiceTool</p>
        </div>
    </footer>
</body>
</html>