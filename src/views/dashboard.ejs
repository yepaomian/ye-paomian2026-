<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard — InvoiceTool</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:'Inter',sans-serif; background:#0b0d15; color:#e8edf5; min-height:100vh; }
        .container { max-width:1120px; margin:0 auto; padding:0 24px; }
        header { padding:20px 0; border-bottom:1px solid rgba(255,255,255,0.06); background:rgba(11,13,21,0.85); backdrop-filter:blur(8px); }
        .nav { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; }
        .nav-left { display:flex; align-items:center; gap:12px; }
        .back-btn { color:#b0b8c8; text-decoration:none; font-size:20px; cursor:pointer; transition:0.2s; line-height:1; }
        .back-btn:hover { color:#fff; transform:scale(1.1); }
        .brand { font-size:24px; font-weight:800; color:#fff; text-decoration:none; }
        .brand span { background:linear-gradient(135deg,#6c5ce7,#a29bfe); padding:2px 10px; border-radius:6px; }
        .nav-links { display:flex; gap:20px; align-items:center; flex-wrap:wrap; }
        .nav-links a { color:#b0b8c8; text-decoration:none; font-size:15px; font-weight:500; }
        .nav-links a:hover { color:#fff; }
        .btn-primary { background:linear-gradient(135deg,#6c5ce7,#a29bfe); color:#fff; border:none; padding:10px 28px; border-radius:40px; font-weight:600; cursor:pointer; transition:0.2s; text-decoration:none; display:inline-block; }
        .btn-primary:hover { transform:translateY(-2px); box-shadow:0 8px 30px rgba(108,92,231,0.35); }
        .btn { background:transparent; color:#b0b8c8; border:1px solid rgba(255,255,255,0.12); padding:10px 28px; border-radius:40px; font-weight:500; cursor:pointer; transition:0.2s; text-decoration:none; display:inline-block; }
        .btn:hover { background:rgba(255,255,255,0.06); color:#fff; }
        .stat-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:20px; margin:30px 0; }
        .stat-card { background:#141824; border-radius:16px; padding:24px; border:1px solid rgba(255,255,255,0.06); text-align:center; }
        .stat-card .num { font-size:32px; font-weight:800; color:#fff; }
        .stat-card .label { color:#8892a8; font-size:14px; margin-top:4px; }
        .invoice-list { background:#141824; border-radius:16px; border:1px solid rgba(255,255,255,0.06); overflow:hidden; margin:30px 0; }
        .invoice-list table { width:100%; border-collapse:collapse; font-size:14px; }
        .invoice-list th { padding:14px 18px; text-align:left; color:#8892a8; border-bottom:1px solid rgba(255,255,255,0.06); font-weight:600; }
        .invoice-list td { padding:14px 18px; border-bottom:1px solid rgba(255,255,255,0.04); color:#e8edf5; }
        .invoice-list tr:last-child td { border-bottom:none; }
        .status-badge { display:inline-block; padding:2px 12px; border-radius:20px; font-size:12px; font-weight:600; }
        .status-draft { background:rgba(255,255,255,0.06); color:#b0b8c8; }
        .status-paid { background:rgba(74,222,128,0.15); color:#4ade80; }
        .status-overdue { background:rgba(248,113,113,0.15); color:#f87171; }
        .empty-state { background:#141824; border-radius:20px; padding:40px; border:1px solid rgba(255,255,255,0.06); text-align:center; }
        .empty-state p { color:#8892a8; margin-bottom:12px; }
        .site-footer { margin-top:60px; padding:30px 0; border-top:1px solid rgba(255,255,255,0.06); text-align:center; }
        .disclaimer { font-size:13px; color:#6b7488; max-width:700px; margin:0 auto 12px; line-height:1.7; }
        .copyright { font-size:13px; color:#4a5266; }
        .flash { padding:12px 20px; border-radius:12px; margin:16px 0; background:#1a1a2e; border:1px solid rgba(255,255,255,0.06); color:#b0b8c8; }
        .loading { text-align:center; padding:40px 0; color:#8892a8; }
        @media (max-width:768px) { .nav-links { gap:12px; } .stat-grid { grid-template-columns:1fr; } }
    </style>
</head>
<body>
    <header>
        <div class="container nav">
            <div class="nav-left">
                <a href="/dashboard" class="back-btn">←</a>
                <a class="brand" href="/dashboard">Invoice<span>Tool</span></a>
            </div>
            <nav class="nav-links">
                <a href="/dashboard">Dashboard</a>
                <a href="/invoices/new">New Invoice</a>
                <a href="/billing">Billing</a>
                <button id="logoutBtn" style="background:none;border:none;color:#b0b8c8;cursor:pointer;font-size:15px;font-weight:500;">Log out</button>
            </nav>
        </div>
    </header>

    <main class="container">
        <div id="app">
            <div class="loading">Loading dashboard...</div>
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <p class="disclaimer"><strong>Disclaimer:</strong> This tool generates invoice templates for informational purposes only. Not legal or tax advice. Please consult a qualified professional. We are not responsible for any errors or financial losses. By using this tool, you agree you are solely responsible for your invoices.</p>
            <p class="copyright">&copy; 2026 InvoiceTool</p>
        </div>
    </footer>

    <script>
        const token = localStorage.getItem('accessToken');
        if (!token) {
            window.location.href = '/login';
        }

        document.getElementById('logoutBtn').addEventListener('click', function() {
            localStorage.removeItem('accessToken');
            localStorage.removeItem('refreshToken');
            localStorage.removeItem('userEmail');
            window.location.href = '/login';
        });

        async function loadDashboard() {
            try {
                const res = await fetch('/dashboard/data', {
                    headers: {
                        'Authorization': 'Bearer ' + token
                    }
                });
                if (res.status === 401 || res.status === 302) {
                    localStorage.removeItem('accessToken');
                    window.location.href = '/login';
                    return;
                }
                const data = await res.json();
                renderDashboard(data);
            } catch (e) {
                document.getElementById('app').innerHTML = '<div class="loading">Error loading dashboard. Please refresh.</div>';
            }
        }

        function renderDashboard(data) {
            const quota = data.quota || {};
            const invoices = data.invoices || [];
            const user = data.user || {};

            let html = `
                <h1 style="font-size:32px;font-weight:800;margin:24px 0 8px;">Dashboard</h1>
                <p style="color:#8892a8;margin-bottom:20px;">Welcome back, ${user.email || ''}.</p>

                <div class="stat-grid">
                    <div class="stat-card"><div class="num">${quota.used || 0}</div><div class="label">Used this month</div></div>
                    <div class="stat-card"><div class="num">${quota.limit || 1}</div><div class="label">Monthly limit</div></div>
                    <div class="stat-card"><div class="num">${quota.remaining || 0}</div><div class="label">Remaining</div></div>
                    <div class="stat-card"><div class="num">${quota.plan ? quota.plan.name : 'Free'}</div><div class="label">Current plan</div></div>
                </div>

                <div style="text-align:center;padding:20px 0 10px;">
                    <a href="/invoices/new" class="btn-primary" style="font-size:18px;padding:14px 40px;">+ New Invoice</a>
                </div>
            `;

            if (invoices && invoices.length > 0) {
                html += `
                    <div class="invoice-list">
                        <table>
                            <thead>
                                <tr>
                                    <th>Invoice #</th>
                                    <th>Client</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${invoices.map(inv => `
                                    <tr>
                                        <td><a href="/invoices/${inv.id}" style="color:#a29bfe;text-decoration:none;">${inv.invoice_number}</a></td>
                                        <td>${inv.to_json && inv.to_json.name ? inv.to_json.name : '-'}</td>
                                        <td>$${inv.total || 0}</td>
                                        <td><span class="status-badge status-${inv.status || 'draft'}">${inv.status || 'draft'}</span></td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                `;
            } else {
                html += `
                    <div class="empty-state">
                        <p>You haven't created any invoices yet.</p>
                        <a href="/invoices/new" class="btn">Create your first invoice</a>
                    </div>
                `;
            }

            document.getElementById('app').innerHTML = html;
        }

        loadDashboard();
    </script>
</body>
</html>